// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  MEMBER
  CLUB_EDITOR
  CLUB_ADMIN
  NATIONAL_ADMIN
  SUPER_ADMIN
}

enum PublishStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum Region {
  NORTHERN_REGION
  SOUTHERN_REGION
  WESTERN_REGION
  EASTERN_REGION
  NORTH_EASTERN_REGION
}

enum EventType {
  ONLINE
  IN_PERSON
  HYBRID
}

enum MediaCategory {
  IMAGE
  DOCUMENT
  VIDEO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// ---------------------------------------------------------------------------
// User and Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          Role      @default(MEMBER)
  passwordHash  String?
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clubOfficer     ClubOfficer?
  committeeMember CommitteeMember?
  mediaAssets     MediaAsset[]
  auditLogs       AuditLog[]
  assignedContacts    ContactEnquiry[]
  assignedMemberships MembershipEnquiry[]

  @@index([email])
  @@index([role])
}

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Clubs
// ---------------------------------------------------------------------------

model Club {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String
  city                String
  state               String
  region              Region
  address             String?
  isLocationVerified  Boolean       @default(false)
  charterYear         String?
  description         String?       @db.Text
  meetingSchedule     String?
  focusAreas          String[]
  email               String?
  phone               String?
  website             String?
  image               String?
  gallery             String[]      @default([])
  status              PublishStatus @default(PUBLISHED)
  isActive            Boolean       @default(true)
  displayOrder        Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  officers            ClubOfficer[]
  projects            ClubProject[]
  events              Event[]
  news                NewsArticle[]
  newsletters         Newsletter[]

  @@index([slug])
  @@index([region])
  @@index([status])
  @@index([isActive])
}

model ClubOfficer {
  id           String   @id @default(cuid())
  clubId       String
  userId       String?  @unique
  title        String
  name         String
  email        String?
  phone        String?
  bio          String?  @db.Text
  image        String?
  tenure       String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([userId])
}

model ClubProject {
  id          String        @id @default(cuid())
  clubId      String
  title       String
  description String?       @db.Text
  status      String        @default("Ongoing")
  image       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// National Committee
// ---------------------------------------------------------------------------

model CommitteeMember {
  id           String    @id @default(cuid())
  userId       String?   @unique
  name         String
  title        String
  portfolio    String?
  organization String?
  city         String?
  state        String?
  bio          String?   @db.Text
  email        String?
  phone        String?
  image        String?
  tenure       String?   @default("Biennium 2024–2026")
  startDate    DateTime?
  endDate      DateTime?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  isHistorical Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
  @@index([isHistorical])
}

// ---------------------------------------------------------------------------
// News
// ---------------------------------------------------------------------------

model NewsCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles NewsArticle[]

  @@index([slug])
}

model NewsArticle {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?       @db.Text
  content         String        @db.Text
  coverImage      String?
  sourceUrl       String?
  metaTitle       String?
  metaDescription String?
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  categoryId      String?
  clubId          String?
  authorName      String?
  tags            String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category        NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  club            Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([categoryId])
  @@index([clubId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  description      String?       @db.Text
  content          String?       @db.Text
  coverImage       String?
  eventType        EventType     @default(IN_PERSON)
  startsAt         DateTime
  endsAt           DateTime?
  timezone         String        @default("Asia/Kolkata")
  venue            String?
  city             String?
  state            String?
  onlineLink       String?
  registrationLink String?
  status           PublishStatus @default(DRAFT)
  isCancelled      Boolean       @default(false)
  clubId           String?
  tags             String[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  club             Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([startsAt])
  @@index([clubId])
}

// ---------------------------------------------------------------------------
// Newsletters
// ---------------------------------------------------------------------------

model Newsletter {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String?       @db.Text
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  mimeType        String?       @default("application/pdf")
  coverImage      String?
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  issueNumber     String?
  volumeNumber    String?
  clubId          String?
  isApproved      Boolean       @default(false)
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  club            Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([clubId])
}

// ---------------------------------------------------------------------------
// External Resources
// ---------------------------------------------------------------------------

model ExternalResource {
  id           String   @id @default(cuid())
  title        String
  url          String
  description  String?  @db.Text
  category     String?
  badge        String?
  target       String?  @default("_blank")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Contact & Membership Enquiries
// ---------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model ContactEnquiry {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String?
  message        String        @db.Text
  status         EnquiryStatus @default(NEW)
  isRead         Boolean       @default(false)
  repliedAt      DateTime?
  assignedToId   String?
  internalNotes  String?       @db.Text
  consentGiven   Boolean       @default(true)
  emailDelivered Boolean       @default(false)
  emailError     String?
  ipHash         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  assignedTo     User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
}

model MembershipEnquiry {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String?
  city           String?
  state          String?
  occupation     String?
  motivation     String?       @db.Text
  preferredClub  String?
  status         EnquiryStatus @default(NEW)
  isRead         Boolean       @default(false)
  repliedAt      DateTime?
  assignedToId   String?
  internalNotes  String?       @db.Text
  consentGiven   Boolean       @default(true)
  emailDelivered Boolean       @default(false)
  emailError     String?
  ipHash         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  assignedTo     User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
}

// ---------------------------------------------------------------------------
// Media Assets
// ---------------------------------------------------------------------------

model MediaAsset {
  id          String        @id @default(cuid())
  filename    String
  url         String
  mimeType    String
  sizeBytes   Int?
  category    MediaCategory @default(IMAGE)
  altText     String?
  caption     String?
  uploadedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// Site Settings
// ---------------------------------------------------------------------------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String?
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}
