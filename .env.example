# ---------------------------------------------------------------------------
# NASI India — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://nasi_user:CHANGE_ME@localhost:5432/nasi_india?schema=public"
DATABASE_URL="postgresql://postgres:root@localhost:5432/nasi_india?schema=public"
# ---------------------------------------------------------------------------
# Prisma Accelerate (optional — only if using Prisma Data Platform)
# Uncomment and set if you are using connection pooling via Prisma Accelerate.
# ---------------------------------------------------------------------------
# PRISMA_ACCELERATE_URL="prisma://accelerate.prisma-data.net/?api_key=CHANGE_ME"

# ---------------------------------------------------------------------------
# Next.js Server Actions encryption key
# Must be a stable, random 32-character hex string shared across all instances.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="48ba2a84814ad98f41446f46653c3e22"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="f48a946b281c7e99a4c0a514d3f32b1e7799aa54c3e1b7890ef01123456789ab"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Administrative & Notification Emails
# Configure either SMTP Relay or Resend Transactional Email API.
# When neither is configured, enquiries are safely saved to PostgreSQL
# and logged for review in the Admin Portal without raising delivery false positives.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_SECURE="false"
EMAIL_FROM="NASI India Secretariat <secretariat@nasiindia.org>"
NOTIFICATIONS_EMAIL_TO="secretariat@nasiindia.org"
RESEND_API_KEY=""
